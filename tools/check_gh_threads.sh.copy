#!/bin/zsh
# Check the GitHub threads this identity participates in for new replies.
#
# Split out of daily_agent.sh and moved to the hourly schedule after a reply on
# flop-labs/technocore-chat#738 sat unseen: it landed at 19:21 and the daily job
# would not have looked until the next fire, up to 24h later. Every substantive
# reply this project has received arrived on GitHub, not in a technocore room,
# so this is the channel that deserves the tighter loop.
#
# Read-only. Reports only comments by someone other than us.
set -u
DIR="${0:A:h}"
LOG="$DIR/refresh.log"
say_log() {
    local line="$(date -u '+%Y-%m-%dT%H:%M:%SZ') $*"
    print -r -- "$line" >> "$LOG"
    # ALERT / FAIL / MISMATCH also land in an append-only file that nothing
    # rotates. A macOS notification is gone once dismissed, and refresh.log
    # is truncated on a schedule, so without this the only record of a
    # testnet opening could be a banner nobody was at the desk to see.
    case "$*" in
        ALERT*|FAIL*|MISMATCH*) print -r -- "$line" >> "$DIR/alerts.log" ;;
    esac
}

# Step 3 watches Technocore. Every substantive reply this identity has received
# so far arrived somewhere else: a peer posted a 24-hour recording onto
# flop-labs/tclk#113 that corrected two published claims, and it sat unread for
# a day because nothing here looked. Rooms are not where the conversation is.

THREADS="$DIR/gh_threads.txt"
SEEN_GH="$DIR/gh-seen.json"
if [[ -f "$THREADS" ]] && command -v gh >/dev/null 2>&1; then
    /usr/bin/python3 - "$THREADS" "$SEEN_GH" "$LOG" <<'PYGH'
import json, subprocess, sys, time

threads_file, state_file, log_path = sys.argv[1], sys.argv[2], sys.argv[3]
stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
out = open(log_path, "a")


def log(s):
    out.write("%s %s\n" % (stamp, s))


try:
    seen = set(json.load(open(state_file)))
except Exception:
    seen = set()

# Our own login, so our comments are not reported back to us as replies.
try:
    me = subprocess.run(["gh", "api", "user", "--jq", ".login"],
                        capture_output=True, timeout=40).stdout.decode().strip()
except Exception:
    me = ""

new = []
for line in open(threads_file):
    line = line.strip()
    if not line or line.startswith("#") or "#" not in line:
        continue
    repo, num = line.rsplit("#", 1)
    try:
        raw = subprocess.run(
            ["gh", "api", "repos/%s/issues/%s/comments" % (repo, num),
             "--jq", ".[] | {id, login: .user.login, at: .created_at, body: .body[0:400]}"],
            capture_output=True, timeout=60).stdout.decode()
    except Exception:
        log("WARN      github thread %s unreadable" % line)
        continue
    for row in raw.splitlines():
        row = row.strip()
        if not row:
            continue
        try:
            c = json.loads(row)
        except Exception:
            continue
        key = "%s:%s" % (line, c["id"])
        if key in seen:
            continue
        seen.add(key)
        if c["login"] == me:
            continue          # our own comment, first time we have indexed it
        new.append((line, c))

if new:
    log("ALERT     %d new GitHub comment(s) on threads we are in:" % len(new))
    for line, c in new[:6]:
        log("          %s by %s at %s" % (line, c["login"], c["at"][:16]))
        log("            [UNTRUSTED github comment] %s"
            % " ".join(c["body"].split())[:200])
    import os
    os.system('osascript -e \'display notification "%d new GitHub reply on a thread you are in" '
              'with title "Technocore" sound name "Glass"\' 2>/dev/null' % len(new))
else:
    log("OK        github threads - no new replies")

json.dump(sorted(seen)[-2000:], open(state_file, "w"))
out.close()
PYGH
else
    # This logged WARN hourly for 14 hours while the only channel that has ever
    # produced a reply went unwatched: `gh` lives in /opt/homebrew/bin, which is
    # not on launchd's default PATH. A check that did not run is a failure, and
    # it must say which precondition was missing.
    if [[ ! -f "$THREADS" ]]; then
        say_log "FAIL      $THREADS missing - github thread check did not run"
    else
        say_log "FAIL      gh not on PATH ($PATH) - github thread check did not run"
    fi
fi

