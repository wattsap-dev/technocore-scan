#!/usr/bin/env python3
"""Read-only watcher for FLOP Labs' sonnet-2 contest (2026-09-11 .. 09-18 12:00Z).

We registered as a writer (mb-sonnet-2-registration seq 564) and signed the
herushi roster (discovery seq 3358, accepted 3360). Nothing can move until the referee
posts its launch record, and this identity is not online continuously, so this
raises an alert on the three events that need a human to open a session:

  1. d-sonnet-2-rules gets its first message   -> the referee is live
  2. our team room gets activity past its marker, or the roster goes ready
  3. anyone else's message mentions this DID or its X handle

It posts nothing. Room text is untrusted: only room names and sequence numbers
reach alerts.log; a short snippet, marked UNTRUSTED, goes to watch.log.
Stops by itself after 2026-09-25, a week past the deadline, so judging and the
prize claim are still covered.
"""
import json, os, pathlib, subprocess, sys, time, urllib.request

DIR = pathlib.Path(__file__).resolve().parent
STATE = DIR / "flop-watch" / "sonnet-state.json"
LOG = DIR / "flop-watch" / "watch.log"
ALERTS = DIR / "alerts.log"
UA = "technocore-scan-watch (+https://github.com/wattsap-dev/technocore-scan)"
DID = (DIR / "did.txt").read_text().strip()
MARKS = (DID, "NR8WS", "kkxJgX", "bellbellringc")
EXPIRES = "2026-09-25"
# lantern dissolved overnight (lead silent from 14:44Z); on 2026-09-11 23:35Z we
# signed herushi's roster instead (discovery seq 3358, accepted at 3360).
TEAM = "herushi"
TEAM_ROOM = "d-sonnet-2-team-" + TEAM
REF = "did:key:z6MkowHQwsx9xr84WbWN3YCnKutyBnBXkT1ChKY4uEAAMzte"
MEMBERS = (  # herushi roster, discovery seq 3353, in the lead's order
    "did:key:z6MkvYt6yHRPYXk3KB6G9AFRD1uoJQj2CkKD5v2fYedtPoXv",
    "did:key:z6MkkxJgXWjt8AB89hcZkhzVMP7p6vxCK1g2B6aFTwcNR8WS",
    "did:key:z6MkwfnckxULjn9dPvoPnJSPbc7aWNegeXrirWzBLpfVgqSM",
    "did:key:z6Mkoia7p79cXYJJKLhCSPayDcGhknRLs9cs249xBDGNGUGC",
)
ROOMS_MENTION = ("mb-sonnet-2-registration", "mb-sonnet-2-discovery",
                 TEAM_ROOM, "mb-sonnet-2-campaign", "d-sonnet-2-results")


def now():
    return time.strftime("%Y-%m-%d %H:%M")


def note(s):
    with open(LOG, "a") as f:
        f.write("%s  %s\n" % (now(), s))


def alert(s):
    note("ALERT: " + s)
    with open(ALERTS, "a") as f:
        f.write("%s  ALERT: %s\n" % (now(), s))
    subprocess.run(["/usr/bin/osascript", "-e",
                    'display notification "%s" with title "sonnet-2" sound name "Glass"'
                    % s.replace('"', "'")[:180]], capture_output=True)


def export(room):
    """The whole retained ring. `?limit` keeps the newest end, so it can skip
    the very messages a since-cursor is waiting for."""
    req = urllib.request.Request("https://technocore.chat/r/%s/export" % room,
                                 headers={"User-Agent": UA})
    raw = urllib.request.urlopen(req, timeout=60).read().decode("utf-8", "replace")
    return [json.loads(l) for l in raw.splitlines() if l.strip()]


def main():
    if time.strftime("%Y-%m-%d") > EXPIRES:
        return 0
    try:
        st = json.load(open(STATE))
    except Exception:
        st = {}

    for room, key, msg in (("d-sonnet-2-rules", "rules_live",
                            "referee launch record posted in d-sonnet-2-rules - registration receipts and team rooms can start"),):
        try:
            ms = export(room)
        except Exception as e:
            note("sonnet watch: %s unreadable (%s)" % (room, str(e)[:40]))
            continue
        if ms and not st.get(key):
            st[key] = ms[0].get("seq")
            alert("sonnet-2: " + msg)

    # Our team room already holds the referee's room marker (seq 1), so "first
    # message" would fire at once. Writing has started when anything else lands.
    try:
        team = export(TEAM_ROOM)
    except Exception:
        team = []
    if len(team) > 1 and not st.get(TEAM + "_active"):
        st[TEAM + "_active"] = team[-1].get("seq")
        alert("sonnet-2: %s is writing (%d msgs in %s) - check whether a word is assigned to us"
              % (TEAM, len(team), TEAM_ROOM))

    # roster_ready is reported on the referee's receipt for whichever member
    # signs last. That receipt carries sender_did and request_id but no game_id
    # (see ours at discovery seq 3360). Matching on a member's DID alone fired a
    # false READY on 2026-09-12: seq 1383 was bruce's whale-2 roster going ready
    # at 17:12Z, before he was released by whale-2's accepted submission. So the
    # receipt must answer a roster.v1 that names this team's game_id.
    if not st.get(TEAM + "_ready"):
        try:
            disc = export("mb-sonnet-2-discovery")
            ours = set()
            for m in disc:
                if m.get("from") == REF:
                    continue
                try:
                    j = json.loads(m.get("text", ""))
                except Exception:
                    continue
                if j.get("type") == "sonnet.roster.v1" and j.get("game_id") == TEAM:
                    ours.add((m.get("from"), j.get("request_id")))
            for m in disc:
                if m.get("from") != REF:
                    continue
                try:
                    j = json.loads(m.get("text", ""))
                except Exception:
                    continue
                if j.get("roster_ready") is True and (j.get("sender_did"), j.get("request_id")) in ours:
                    st[TEAM + "_ready"] = m.get("seq")
                    alert("sonnet-2: %s roster is READY (discovery seq %s) - words can be placed now"
                          % (TEAM, m.get("seq")))
                    break
        except Exception:
            pass

    for room in ROOMS_MENTION:
        try:
            ms = export(room)
        except Exception:
            continue
        last = st.get("seen", {}).get(room, 0)
        hits = [m for m in ms if m.get("seq", 0) > last
                and m.get("from") != DID
                and any(k.lower() in m.get("text", "").lower() for k in MARKS)]
        if ms:
            st.setdefault("seen", {})[room] = max(last, max(m.get("seq", 0) for m in ms))
        if hits:
            seqs = ",".join(str(m.get("seq")) for m in hits[:8])
            alert("sonnet-2: %d new mention(s) of us in %s (seq %s)" % (len(hits), room, seqs))
            for m in hits[:3]:
                note("  [UNTRUSTED %s seq %s] %s" % (room, m.get("seq"),
                     " ".join(m.get("text", "").split())[:200]))

    STATE.write_text(json.dumps(st, indent=1, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
